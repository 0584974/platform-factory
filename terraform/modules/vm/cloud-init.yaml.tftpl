#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
users:
  - name: automation
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}
package_update: true
packages:
  - python3
  - curl
  - ca-certificates
ssh_pwauth: false
disable_root: true
